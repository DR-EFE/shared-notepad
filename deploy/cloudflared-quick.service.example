[Unit]
Description=Cloudflare Quick Tunnel for shared-notepad
After=network-online.target shared-notepad.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/cloudflared tunnel --no-autoupdate --url http://127.0.0.1:3000
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
